# Copy to .env (`make up` / `make test` do this for you if .env is missing).
# .env is git-ignored. Replace the placeholder password outside local development.
POSTGRES_PASSWORD=change-me-local-only

# Used when running the app or tests on the host instead of in compose.
DATABASE_URL=postgresql://gradebot:change-me-local-only@localhost:5432/gradebot

PROMPT_VERSION=grade_v1
LLM_TIMEOUT_S=10
LLM_BACKOFF_BASE_S=0.2
